# Embeddings — set ONE of these (Gemini is used if both are set)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: override the embedding model
# EMBEDDING_MODEL=gemini-embedding-001
# Optional: override the chat model
# CHAT_MODEL=gemini-3.8-flash

# Redis / Valkey
REDIS_HOST=localhost
REDIS_PORT=6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf-docs
# QDRANT_API_KEY=
